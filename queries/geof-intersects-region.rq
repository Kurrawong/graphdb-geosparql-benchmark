PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>

SELECT ?result ?wkt
WHERE {
  ?result geo:asWKT ?wkt .
  FILTER(
    geof:sfIntersects(
      ?wkt,
      "POLYGON((71.71689397797601 7.419094102713061, 72.27946321523228 -1.1898124287125, 74.76601924390499 -1.2010613645552013, 74.1471930829231 7.597572649973657, 71.71689397797601 7.419094102713061))"^^geo:wktLiteral
    )
  )
}
